{
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.0",
    "body": [
        {
            "type": "Image",
            "url": "https://raw.githubusercontent.com/nf-core/logos/master/nf-core-logo.png"
        },
        {
            "type": "TextBlock",
            "text": "CDCgov/FoodNetTrends v${version} - ${runName}",
            "weight": "bolder",
            "size": "large",
            "wrap": true
        },
        {
            "type": "TextBlock",
            "text": "Completed at ${dateComplete} (duration: ${duration})",
            "weight": "bolder",
            "wrap": true
        },
        {
            "type": "TextBlock",
            "text": "The workflow was run on `${profile}` with work directory: `${workDir}`.",
            "wrap": true
        },
        {
            "type": "Container",
            "items": [
                {
                    "type": "TextBlock",
                    "text": "Execution summary",
                    "weight": "bolder"
                }
            ],
            "style": "emphasis"
        },
        {
            "type": "FactSet",
            "facts": [
                {
                    "title": "Exit status",
                    "value": "${exitStatus}"
                },
                {
                    "title": "Launch directory",
                    "value": "${launchDir}"
                },
                {
                    "title": "Results directory",
                    "value": "${outDir}"
                }
            ]
        }
    ],
    "msteams": {
        "width": "Full"
    }
}
