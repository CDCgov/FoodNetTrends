# Force Unix line endings for all text files to prevent HPC failures
* text=auto eol=lf

## Web files
*.htm text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

## Critical pipeline files - MUST have LF line endings
*.sh text eol=lf
*.R text eol=lf
*.r text eol=lf
*.nf text eol=lf
*.groovy text eol=lf
*.config text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.def text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.bak text eol=lf
*.csv text eol=lf

## Nextflow specific files
nextflow.config text eol=lf
main.nf text eol=lf
foodnet.def text eol=lf
foodnet.yml text eol=lf

## Binary files - do not modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.sas7bdat binary
*.rds binary
*.RData binary
*.rda binary
*.zip binary
*.gz binary
*.tar binary

