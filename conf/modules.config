/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'TRENDY' {
        publishDir = [
            path: { "${params.outdir}/${params.projID}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        
        // Check for max analysis settings and apply higher resources
        // Triggered when iterations > 5000 or chains > 6
        memory = { 
            if (params.iterations && params.iterations.toString().toInteger() > 5000 ||
                params.chains && params.chains.toString().toInteger() > 6) {
                check_max(128.GB * task.attempt, 'memory')
            } else {
                check_max(72.GB * task.attempt, 'memory')
            }
        }
        
        // Set appropriate CPU count based on chains
        cpus = {
            if (params.chains && params.chains.toString().toInteger() > 0) {
                // Ideally use chains * 2 CPUs for optimal parallelization
                def requestedCpus = params.chains.toString().toInteger() * 2
                check_max(requestedCpus, 'cpus')
            } else {
                check_max(16 * task.attempt, 'cpus')
            }
        }
        
        // Longer time for max settings
        time = {
            if (params.iterations && params.iterations.toString().toInteger() > 5000) {
                check_max(48.h * task.attempt, 'time')
            } else {
                check_max(24.h * task.attempt, 'time')
            }
        }
    }

    withName: CUSTOM_DUMPSOFTWAREVERSIONS {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*_versions.yml'
        ]
    }
}
