/*
==========================================================================================
    FoodNet Trends Pipeline - CDC SciComp Configuration
==========================================================================================
    Optimized Nextflow configuration for running FoodNet Trends pipeline on CDC's 
    Sun Grid Engine (SGE) cluster. This config combines CDC's infrastructure tuning
    with FoodNet's high-resource MCMC requirements.
    
    Usage: nextflow run main.nf -C fnt.scicomp.config -profile singularity,fnt_production
----------------------------------------------------------------------------------------
*/

/*
==========================================================================================
    Enhanced resource parameters for MCMC workloads
==========================================================================================
*/

params {
  config_profile_description = 'FoodNet Trends @ CDC SciComp'
  config_profile_contact = 'OAMD & FoodNet Team'
  config_profile_url = 'https://info.biotech.cdc.gov/info/'
  custom_config_version = 'master'

  // Enhanced resource parameters for MCMC modeling
  max_memory                 = '128.GB'
  max_cpus                   = 32
  max_time                   = '240.h'
}

/*
==========================================================================================
    FoodNet-optimized profiles for CDC infrastructure
==========================================================================================
*/

profiles {
  fnt_production {
    executor {
      name = 'sge'
      queueSize = 100                    // Allow many concurrent pathogen jobs
      pollInterval = '10sec'             // Optimized SGE polling
      submitRateLimit = '10/1min'        // Faster than scicomp default
    }
    
    process {
      executor = 'sge'
      penv = 'smp'
      
      // Smart queue selection for different job types
      queue = { task.time <= 4.h ? 'short.q' : task.memory.toGiga() >= 40 ? 'highmem.q' : 'all.q' }
      
      // Enhanced error handling for HPC and MCMC-specific failures
      errorStrategy = { task.exitStatus in [143,137,104,134,139,140,71,255] ? 'retry' : 'finish' }
      maxRetries = 3
      maxErrors = '-1'
      
      // Prevent Singularity mounting issues
      scratch = false
      
      // Default settings for lightweight processes
      memory = { check_max(8.GB * task.attempt, 'memory') }
      cpus = { check_max(2 * task.attempt, 'cpus') }
      time = { check_max(4.h * task.attempt, 'time') }
      clusterOptions = { "-l h_vmem=${(check_max((task.memory.toGiga())+4), 'memory').toString().replaceAll(/[\sB]/,'')}G" }
      
      // MCMC-optimized settings for TRENDY processes
      withName: 'TRENDY' {
        memory = { check_max(48.GB * task.attempt, 'memory') }
        cpus = { check_max(16 * task.attempt, 'cpus') }
        time = { check_max(72.h * task.attempt, 'time') }
        queue = 'highmem.q'              // Force high-memory queue for MCMC
        
        // Dynamic h_vmem with MCMC-appropriate buffer
        clusterOptions = { "-l h_vmem=${(check_max((task.memory.toGiga())+8), 'memory').toString().replaceAll(/[\sB]/,'')}G" }
        
        // Additional SGE options for MCMC stability
        beforeScript = 'echo "Starting MCMC analysis on $HOSTNAME at $(date)"'
      }
      
      // Preprocessing optimized settings
      withName: 'PREPROCESS' {
        memory = { check_max(16.GB * task.attempt, 'memory') }
        cpus = { check_max(4 * task.attempt, 'cpus') }
        time = { check_max(8.h * task.attempt, 'time') }
        queue = 'short.q'                // Fast queue for data processing
        clusterOptions = { "-l h_vmem=${(check_max((task.memory.toGiga())+4), 'memory').toString().replaceAll(/[\sB]/,'')}G" }
      }
    }
  }
  
  fnt_testing {
    executor {
      name = 'sge'
      queueSize = 10                     // Limited concurrent jobs for testing
      pollInterval = '15sec'
      submitRateLimit = '5/1min'
    }
    
    process {
      executor = 'sge'
      penv = 'smp'
      queue = 'short.q'                 // Use short queue for testing
      
      errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
      maxRetries = 2
      scratch = false
      
      // Reduced resources for testing
      memory = { check_max(16.GB * task.attempt, 'memory') }
      cpus = { check_max(4 * task.attempt, 'cpus') }
      time = { check_max(8.h * task.attempt, 'time') }
      clusterOptions = { "-l h_vmem=${(check_max((task.memory.toGiga())+4), 'memory').toString().replaceAll(/[\sB]/,'')}G" }
      
      // Testing-friendly TRENDY settings
      withName: 'TRENDY' {
        memory = { check_max(24.GB * task.attempt, 'memory') }
        cpus = { check_max(8 * task.attempt, 'cpus') }
        time = { check_max(12.h * task.attempt, 'time') }
        clusterOptions = { "-l h_vmem=${(check_max((task.memory.toGiga())+4), 'memory').toString().replaceAll(/[\sB]/,'')}G" }
      }
    }
  }
  
  fnt_max {
    executor {
      name = 'sge'
      queueSize = 50                     // Moderate concurrency for intensive jobs
      pollInterval = '10sec'
      submitRateLimit = '5/1min'         // Slower submission for large jobs
    }
    
    process {
      executor = 'sge'
      penv = 'smp'
      queue = 'long.q'                  // Force long queue for max profile
      
      errorStrategy = { task.exitStatus in [143,137,104,134,139,140,71,255] ? 'retry' : 'finish' }
      maxRetries = 2                    // Fewer retries for expensive jobs
      scratch = false
      
      // Standard settings
      memory = { check_max(8.GB * task.attempt, 'memory') }
      cpus = { check_max(2 * task.attempt, 'cpus') }
      time = { check_max(4.h * task.attempt, 'time') }
      clusterOptions = { "-l h_vmem=${(check_max((task.memory.toGiga())+4), 'memory').toString().replaceAll(/[\sB]/,'')}G" }
      
      // Maximum resource TRENDY settings
      withName: 'TRENDY' {
        memory = { check_max(64.GB * task.attempt, 'memory') }
        cpus = { check_max(24 * task.attempt, 'cpus') }
        time = { check_max(120.h * task.attempt, 'time') }
        
        // Enhanced h_vmem buffer for max profile
        clusterOptions = { "-l h_vmem=${(check_max((task.memory.toGiga())+16), 'memory').toString().replaceAll(/[\sB]/,'')}G" }
        
        beforeScript = 'echo "Starting MAX profile MCMC analysis on $HOSTNAME at $(date)"; ulimit -v unlimited'
      }
    }
  }
  
  singularity {
    // Enhanced Singularity configuration
    singularity.enabled    = true
    singularity.autoMounts = true
    singularity.runOptions = '--bind /scicomp'     // CDC-specific mount
    
    // Disable other container engines
    docker.enabled         = false
    conda.enabled          = false
    podman.enabled         = false
    shifter.enabled        = false
    charliecloud.enabled   = false
    
    process {
      // Prevent Singularity container creation errors
      scratch = false
      container = 'foodnet.sif'
    }
  }
  
  debug {
    // Enhanced debugging for FoodNet pipeline
    dumpHashes = true
    cleanup = false
    nextflow.enable.configProcessNamesValidation = true
    
    process {
      shell = ['/bin/bash', '-x']
      beforeScript = 'echo "DEBUG: $HOSTNAME - $(date) - Task: $task.name"'
      
      // Enhanced error strategy for debugging
      errorStrategy = { task.exitStatus in [143,137,104,134,139,140,71,255] ? 'retry' : 'ignore' }
      maxRetries = 1                    // Single retry in debug mode
    }
    
    env {
      NXF_DEBUG = '2'                   // Moderate debug verbosity
    }
  }
}

/*
==========================================================================================
    Enhanced resource checking function
==========================================================================================
*/

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1) {
                println "WARNING: Memory request ${obj} exceeds max_memory ${params.max_memory}. Using max_memory."
                return params.max_memory as nextflow.util.MemoryUnit
            } else {
                return obj
            }
        } catch (all) {
            println "INFO: Updating max_memory from '${params.max_memory}' to ${obj} based on task requirements"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1) {
                println "WARNING: Time request ${obj} exceeds max_time ${params.max_time}. Using max_time."
                return params.max_time as nextflow.util.Duration
            } else {
                return obj
            }
        } catch (all) {
            println "INFO: Updating max_time from '${params.max_time}' to ${obj} based on task requirements"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            def result = Math.min(obj, params.max_cpus as int)
            if (result != obj) {
                println "WARNING: CPU request ${obj} exceeds max_cpus ${params.max_cpus}. Using max_cpus."
            }
            return result
        } catch (all) {
            println "INFO: Updating max_cpus from '${params.max_cpus}' to ${obj} based on task requirements"
            return obj
        }
    }
}

/*
==========================================================================================
    Pipeline reporting configuration
==========================================================================================
*/

def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline {
    enabled = true
    file = "${params.outdir}/${params.projID}/pipeline_info/fnt_timeline_${trace_timestamp}.html"
}

report {
    enabled = true
    file = "${params.outdir}/${params.projID}/pipeline_info/fnt_report_${trace_timestamp}.html"
}

trace {
    enabled = true
    file = "${params.outdir}/${params.projID}/pipeline_info/fnt_trace_${trace_timestamp}.txt"
}

dag {
    enabled = true
    file = "${params.outdir}/${params.projID}/pipeline_info/fnt_dag_${trace_timestamp}.html"
}