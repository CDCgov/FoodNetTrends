Bootstrap: docker
From: ubuntu:22.04

%labels
    author Josh Forstedt
    date 2025-5-18
        description FoodNet container with Rscript support
    version v1.0

%post
    # Set non-interactive environment
    export DEBIAN_FRONTEND=noninteractive
    export TZ=America/New_York
    
    # Install system dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
        dirmngr \
        gpg-agent \
        wget \
        ca-certificates \
        && apt-get clean && rm -rf /var/lib/apt/lists/*
        
    # Add R repository
    wget -qO- https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc | tee -a /etc/apt/trusted.gpg.d/cran_ubuntu_key.asc
    add-apt-repository "deb https://cloud.r-project.org/bin/linux/ubuntu $(lsb_release -cs)-cran40/"
    
    # Install R and dependencies - without version pinning to avoid conflicts
    apt-get update && apt-get install -y --no-install-recommends \
        r-base \
        r-base-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        libhdf5-dev \
        libfontconfig1-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libfreetype6-dev \
        libpng-dev \
        libtiff5-dev \
        libjpeg-dev \
        build-essential \
        && apt-get clean && rm -rf /var/lib/apt/lists/*
    
    # Verify R installation before proceeding
    R --version
    
    # Make R package installation non-interactive
    echo "options(repos = c(CRAN = 'https://cloud.r-project.org/'), download.file.method = 'libcurl')" >> /usr/lib/R/etc/Rprofile.site
    
    # Install required R packages non-interactively
    # Statistical modeling
    R -e "options(Ncpus = 4); install.packages('brms', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('rstan', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('tidybayes', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('HDInterval', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    
    # Data manipulation
    R -e "options(Ncpus = 4); install.packages('tidyverse', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('dplyr', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('tidyr', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('readr', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('haven', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('tibble', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('jsonlite', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('gtools', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('reshape2', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    
    # Argument parsing
    R -e "options(Ncpus = 4); install.packages('argparse', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    
    # Visualization 
    R -e "options(Ncpus = 4); install.packages('ggplot2', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('gridExtra', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('htmlwidgets', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('plotly', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('DT', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('htmltools', dependencies=TRUE, repos='https://cloud.r-project.org/')"
    R -e "options(Ncpus = 4); install.packages('base64enc', dependencies=TRUE, repos='https://cloud.r-project.org/')"

    # Create directory for pipeline-specific files
    mkdir -p /opt/foodnet
    chmod -R 777 /opt/foodnet

%environment
    export LC_ALL=C
    export LANG=C
    export R_HOME=/usr/lib/R
    export PATH=/usr/bin:$PATH

%runscript
    echo "FoodNet Trends Analysis Pipeline v1.0"
    echo "This container provides the environment for running the FoodNet Trends pipeline."
    echo "For usage, see the README.md file at https://github.com/CDC-DIDRI/FoodNetTrends"
    echo ""
    echo "Available commands:"
    echo "  R            - Start R environment"
    echo "  Rscript      - Run R scripts"
    echo ""

%help
    FoodNet Trends Analysis Pipeline v1.0
    
    This Singularity container provides all required dependencies for running
    the FoodNet Trends pipeline, which performs Bayesian modeling of foodborne
    disease surveillance data.
    
    Main dependencies:
    - R 4.4 with packages:
      - brms 2.22.0
      - dplyr 1.1.4
      - ggplot2 3.5.1
      - And other required packages with pinned versions
    
    Usage with Nextflow:
      nextflow run main.nf -profile singularity
