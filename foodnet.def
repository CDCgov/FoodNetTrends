Bootstrap: docker
From: rocker/r-ver:4.4

%labels
    author Josh Forstedt
    date 2025-5-18
    description FoodNet container with efficient R package installation
    version v1.0

%post
    # Set non-interactive environment
    export DEBIAN_FRONTEND=noninteractive
    export TZ=America/New_York
    
    # Install system dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        wget \
        bzip2 \
        ca-certificates \
        libglib2.0-0 \
        libxext6 \
        libsm6 \
        libxrender1 \
        git \
        && apt-get clean && rm -rf /var/lib/apt/lists/*
        
    # Install miniconda and add to path
    wget -q https://repo.anaconda.com/miniconda/Miniconda3-py310_23.10.0-1-Linux-x86_64.sh -O miniconda.sh
    bash miniconda.sh -b -p /opt/conda
    rm miniconda.sh
    export PATH="/opt/conda/bin:$PATH"
    
    # Initialize conda and configure channels
    . /opt/conda/etc/profile.d/conda.sh
    conda config --add channels conda-forge
    conda config --add channels bioconda
    conda config --set channel_priority strict
    
    # Install essential R packages with conda (much faster than from source)
    conda install -y -c conda-forge -c bioconda \
        r-tidyverse \
        r-brms \
        r-rstan \
        r-tidybayes \
        r-hdinterval \
        r-argparse \
        r-gridextra \
        r-jsonlite \
        r-gtools \
        r-reshape2 \
        r-htmlwidgets \
        r-plotly \
        r-dt \
        r-htmltools \
        r-base64enc
    
    # Create directory for pipeline-specific files
    mkdir -p /opt/foodnet
    chmod -R 777 /opt/foodnet

%environment
    export LC_ALL=C
    export LANG=C
    export PATH=/opt/conda/bin:$PATH
    
%runscript
    echo "FoodNet Trends Analysis Pipeline v1.0"
    echo "This container provides the environment for running the FoodNet Trends pipeline."
    echo "For usage, see the README.md file at https://github.com/CDC-DIDRI/FoodNetTrends"
    echo ""
    echo "Available commands:"
    echo "  R            - Start R environment"
    echo "  Rscript      - Run R scripts"
    echo ""

%help
    FoodNet Trends Analysis Pipeline v1.0
    
    This Singularity container provides all required dependencies for running
    the FoodNet Trends pipeline, which performs Bayesian modeling of foodborne
    disease surveillance data.
    
    Main dependencies:
    - R 4.4 (from rocker/r-ver base image)
    - Key R packages (installed via conda for efficiency):
      - tidyverse
      - brms
      - rstan
      - And other required packages
    
    Usage with Nextflow:
      nextflow run main.nf -profile singularity
